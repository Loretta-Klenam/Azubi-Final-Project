# Copy this file to backend-local.hcl (gitignored) and fill in your values.
# Then run:  terraform -chdir=terraform init -backend-config=../terraform/backend-local.hcl
#
# The bootstrap module (terraform/bootstrap/) creates the bucket and lock table.

bucket         = "YOUR_TF_STATE_BUCKET_NAME"
key            = "event-ticketing/dev/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "event-ticketing-tfstate-lock"
encrypt        = true
