# Copy to .env.local for local development (npm run dev), or set as
# GitHub Actions build-time env vars for production (see docs/deployment.md).
# The deploy workflow populates these automatically from CDK stack outputs.

VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/v1
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_ATTENDEE_USER_POOL_ID=us-east-1_yyyyyyyyy
VITE_ATTENDEE_CLIENT_ID=yyyyyyyyyyyyyyyyyyyyyyyyyy
